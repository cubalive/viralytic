{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@viralytic/db": ["packages/db/src"],
      "@viralytic/shared": ["packages/shared/src"],
      "@viralytic/ai": ["packages/ai/src"],
      "@viralytic/integrations": ["packages/integrations/src"],
      "@viralytic/scrapers": ["packages/scrapers/src"],
      "@viralytic/video": ["packages/video/src"]
    }
  }
}
