{
  "name": "@viralytic/mv-render",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import=tsx/esm src/index.ts",
    "plan": "node --import=tsx/esm src/plan-scenes.ts",
    "plan:dev": "tsx watch src/plan-scenes.ts",
    "bank": "node --import=tsx/esm src/bank-enrich.ts",
    "faceless": "node --import=tsx/esm src/faceless-render.ts",
    "canon": "node --import=tsx/esm src/canon-builder.ts",
    "song": "node --import=tsx/esm src/caroline-song.ts",
    "caroline:poll": "node --import=tsx/esm src/caroline-poll.ts",
    "sync:bank": "tsx src/sync-bank.ts",
    "worker": "node --import=tsx/esm src/worker.ts",
    "faceless:dev": "tsx watch src/faceless-render.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@sync.so/sdk": "^0.3.0",
    "dotenv": "^16.4.0",
    "openai": "^4.65.0",
    "tsx": "^4.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
