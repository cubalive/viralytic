# === Google Vertex AI ===
# Las credenciales se toman de ADC (gcloud auth application-default login) — no se ponen aquí.
GCP_PROJECT_ID=passkal
GCP_LOCATION=us-central1
# Nota: Gemini usa la región 'global' internamente (ya verificado). Imagen/Veo usan GCP_LOCATION.

# === IDs de modelos (sobrescribe si cambian) ===
# Las FOTOS (canon + keyframes) se generan con Gemini (no Imagen):
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
VEO_MODEL=veo-3.1-generate-preview
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
# Imagen queda como alternativa opcional (no se usa por defecto):
IMAGEN_MODEL=imagen-3.0-generate-002
IMAGEN_CUSTOM_MODEL=imagen-3.0-capability-001

# === Lip sync (opcional) ===
# Si LIPSYNC_PROVIDER queda vacío, el pipeline copia el clip SIN sincronizar (modo noop) y sigue.
# Para activar un proveedor por API: LIPSYNC_PROVIDER=api + URL + KEY (ver src/stages/lipsync/index.ts)
LIPSYNC_PROVIDER=
LIPSYNC_API_URL=
LIPSYNC_API_KEY=

# === ffmpeg (deja el valor por defecto si están en el PATH) ===
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# === Lip sync (Sync.so) ===
SYNC_API_KEY=
SYNC_MODEL=lipsync-2

# === Voz (ElevenLabs) ===
ELEVENLABS_API_KEY=

# === Librería de sonidos (Supabase Storage) ===
SOUNDS_SUPABASE_URL=
SOUNDS_SUPABASE_KEY=
SOUNDS_BUCKET=reels-music
