# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Redis (Upstash)
REDIS_URL=

# Workers HTTP bridge (web -> workers /enqueue). Keeps BullMQ out of Next's
# bundle entirely. WORKERS_HTTP_PORT is for the workers process, WORKERS_URL
# is what the web uses to reach it, ENQUEUE_SECRET is the shared header
# secret that authorizes enqueue requests. Generate with: openssl rand -hex 32
WORKERS_HTTP_PORT=4001
WORKERS_URL=http://localhost:4001
ENQUEUE_SECRET=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
REVID_API_KEY=

# TikTok (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Token encryption (AES-256-GCM) — encrypts TikTok OAuth tokens at rest.
# 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Trending sources
APIFY_TOKEN=
SCRAPINGBEE_API_KEY=

# Stripe (SaaS billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=

# Misc
NODE_ENV=development
APP_URL=http://localhost:3000
